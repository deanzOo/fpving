{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner", "@stryker-mutator/typescript-checker"],
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.tools.json",
  "vitest": { "configFile": "stryker.vitest.config.ts" },
  "ignorePatterns": ["/apps/docs", "/.data", "/.env", "/coverage", "/reports", "/graphify-out", "**/dist"],
  "mutate": [
    "packages/core/src/**/*.ts",
    "packages/plugin-sdk/src/**/*.ts",
    "!packages/*/src/index.ts",
    "!packages/core/src/testing/**",
    "!packages/plugin-sdk/src/contract/index.ts",
    "!packages/plugin-sdk/src/contract/check.ts",
    "!packages/plugin-sdk/src/contract/run-contract.ts"
  ],
  "timeoutMS": 15000,
  "thresholds": { "high": 95, "low": 85, "break": 85 },
  "reporters": ["html", "clear-text", "progress"],
  "htmlReporter": { "fileName": "reports/mutation/index.html" },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always"
}

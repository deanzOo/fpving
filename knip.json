{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tools/**/*.ts", "tests/**/*.test.ts"],
      "project": ["*.ts", "tools/**/*.ts", "tests/**/*.ts"],
      "ignore": ["tests/tooling/fixtures/**"],
      "ignoreBinaries": ["osv-scanner", "mkfifo"]
    },
    "packages/*": { "project": ["src/**/*.ts"] },
    "packages/core": { "project": ["src/**/*.ts", "eval/**/*.ts"] },
    "apps/*": { "project": ["src/**/*.ts"] },
    "apps/ui": { "project": ["src/**/*.{ts,tsx,css}", "test/**/*.{ts,tsx}"] },
    "apps/docs": { "project": ["*.ts", "src/**/*.ts", "src/**/*.{astro,mdx}"] }
  }
}

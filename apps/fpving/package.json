{
  "name": "@fpving/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "exports": {
    ".": "./dist/index.js",
    "./api-routes": {
      "@fpving/source": "./src/server/api-routes.ts",
      "types": "./dist/server/api-routes.d.ts",
      "import": "./dist/server/api-routes.js"
    },
    "./errors": {
      "@fpving/source": "./src/server/errors.ts",
      "types": "./dist/server/errors.d.ts",
      "import": "./dist/server/errors.js"
    },
    "./http-status": {
      "@fpving/source": "./src/server/http-status.ts",
      "types": "./dist/server/http-status.d.ts",
      "import": "./dist/server/http-status.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "start": "tsc -b && node --env-file-if-exists=../../.env dist/main.js",
    "db:generate": "node --conditions=@fpving/source node_modules/drizzle-kit/bin.cjs generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@fastify/static": "10.1.8",
    "@fpving/core": "workspace:*",
    "@fpving/plugin-sdk": "workspace:*",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "node-notifier": "11.0.0",
    "pino": "10.4.0",
    "playwright": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/node-notifier": "8.0.5",
    "drizzle-kit": "0.31.11",
    "vitest": "5.0.5"
  }
}

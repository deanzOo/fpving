{
  "name": "fpving-root",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dup": "jscpd",
    "knip": "knip",
    "licenses:check": "license-checker-rseidelsohn --excludePrivatePackages --onlyAllow \"MIT;ISC;BSD-2-Clause;BSD-3-Clause;Apache-2.0;0BSD;BlueOak-1.0.0;CC0-1.0;Unlicense;Python-2.0;CC-BY-4.0;CC-BY-3.0;MPL-2.0;(MIT AND CC-BY-3.0)\"",
    "audit:osv": "osv-scanner scan source --lockfile pnpm-lock.yaml",
    "worktree:init": "node tools/worktree-init-cli.ts",
    "eval:matcher": "pnpm build && node --env-file-if-exists=.env node_modules/jiti/lib/jiti-cli.mjs tools/matcher-eval-cli.ts",
    "docs:spec": "node tools/spec-to-docs-cli.ts",
    "docs:build": "pnpm build && pnpm docs:spec && pnpm --filter @fpving/docs build",
    "docs:dev": "pnpm build && pnpm docs:spec && pnpm --filter @fpving/docs dev",
    "verify": "pnpm build && pnpm lint && pnpm test:coverage && pnpm docs:build && pnpm dup && pnpm knip && pnpm licenses:check",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/lint": "21.2.3",
    "@commitlint/load": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@fpving/core": "workspace:*",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "eslint-plugin-jsdoc": "65.3.1",
    "eslint-plugin-tsdoc": "0.5.4",
    "jiti": "2.7.0",
    "jscpd": "5.4.1",
    "knip": "6.41.0",
    "lefthook": "2.2.1",
    "license-checker-rseidelsohn": "5.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "overrides": {
      "eslint-plugin-tsdoc>@typescript-eslint/utils": "8.71.2",
      "@esbuild-kit/core-utils>esbuild": "0.25.12"
    },
    "ignoredBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}

{
  "name": "fpving-root",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @fpving/ui build",
    "dev": "tsc -b && node tools/dev-cli.ts",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --project=!e2e",
    "test:e2e": "vitest run --project e2e --reporter=default",
    "mutation": "pnpm build && stryker run",
    "dup": "jscpd",
    "knip": "knip",
    "licenses:check": "pnpm licenses list -r --json | node tools/license-check-cli.ts",
    "audit:osv": "osv-scanner scan source --lockfile pnpm-lock.yaml",
    "worktree:init": "node tools/worktree-init-cli.ts",
    "tokens": "node tools/design-tokens-cli.ts",
    "eval:matcher": "pnpm build && node --env-file-if-exists=.env node_modules/jiti/lib/jiti-cli.mjs tools/matcher-eval-cli.ts",
    "docs:spec": "node tools/spec-to-docs-cli.ts && node tools/api-to-docs-cli.ts",
    "docs:build": "pnpm build && pnpm docs:spec && pnpm --filter @fpving/docs build",
    "docs:dev": "pnpm build && pnpm docs:spec && pnpm --filter @fpving/docs dev",
    "verify": "pnpm build && pnpm lint && pnpm test:coverage && pnpm test:e2e && pnpm docs:build && pnpm dup && pnpm knip && pnpm licenses:check",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/lint": "21.2.3",
    "@commitlint/load": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@fpving/core": "workspace:*",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.12.0",
    "eslint-plugin-jsdoc": "65.3.1",
    "eslint-plugin-tsdoc": "0.5.4",
    "jiti": "2.7.0",
    "jscpd": "5.4.1",
    "knip": "6.41.0",
    "lefthook": "2.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "pnpm": {
    "overrides": {
      "eslint-plugin-tsdoc>@typescript-eslint/utils": "8.71.2",
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "glob@13": "14.0.2",
      "typed-rest-client>qs": "6.16.1"
    },
    "ignoredBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}

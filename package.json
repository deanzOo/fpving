{
  "name": "fpving-root",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dup": "jscpd",
    "knip": "knip",
    "ci": "pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm dup && pnpm knip",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/lint": "21.2.3",
    "@commitlint/load": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "jiti": "2.7.0",
    "jscpd": "5.4.1",
    "knip": "6.41.0",
    "lefthook": "2.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
